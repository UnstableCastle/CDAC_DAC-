@model List<Employee>

<h1>List of Employee</h1>

<div class="d-flex flex-wrap gap-3">
    @foreach (Employee employee in Model)
    {
        <div class="card" style="width: 18rem;">
            <div class="card-body">

                <h5 class="card-title">@employee.EmpId </h5>
                <h6 class="card-subtitle mb-2 text-muted">Customer ID: @employee.EmpName </h6>
                <p class="card-text">City: @employee.Designation </p>
                <p class="card-text">City: @employee.salary </p>
            </div>
        </div>
    }
</div>