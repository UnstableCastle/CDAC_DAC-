@model List<Customer>

<h1>List of Customer</h1>


<table class="table table-striped-columns border-1 c">
    <thead>

        <tr>

            <th>Customer Id</th>
            <th>Customer Name</th>
            <th>Customer City</th>
            <th>Customer City</th>

        </tr>
    </thead>
    <tbody>
        @foreach (Customer customer in Model)
        {
            <tr>
                <td>@customer.CustomerId</td>
                <td>@customer.Name</td>
                <td>@customer.City</td>
            </tr>

        }



    </tbody>
</table>